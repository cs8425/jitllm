#!/usr/bin/env bash
# go vet over a module, every analyzer on and nothing allowed.
#
#     scripts/vet            # the engine module
#     scripts/vet server     # a nested module: server, common, ui, tui
#
# It once held an allowlist of unsafe.Pointer findings, which is how a vet
# failure stayed green in CI. There is none now: a finding is fixed, not
# argued. `GOOS=windows scripts/vet` vets the Windows build from a Linux box.
set -euo pipefail
cd "$(dirname "$0")/.."

if [ $# -gt 0 ] && [ -f "$1/go.mod" ]; then
  cd "$1"
  shift
fi
go vet "$@" ./...
echo "vet clean in $(pwd) ($(go env GOOS)/$(go env GOARCH))"
